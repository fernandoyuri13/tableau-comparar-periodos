<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.example.tableau.comparar-periodos-dashboard" extension-version="0.4.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Seleciona dois intervalos de datas independentes para comparar no painel.</description>
    <author name="Yuri Fernando dos Santos" email="46434891+fernandoyuri13@users.noreply.github.com" website="https://github.com/fernandoyuri13"/>
    <min-api-version>1.9</min-api-version>
    <source-location>
      <url>http://localhost:8765/comparar-periodos-0.4.html</url>
    </source-location>
    <icon></icon>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Comparar períodos</text>
    </resource>
  </resources>
</manifest>
